# --- logins (PIN is the only key; it also picks the warehouse) ---
PIN_JNK=0000
PIN_MUSCLE_FUSION=0000

# --- labels shown in the app ---
NAME_JNK=JNK Warehouse
NAME_MUSCLE_FUSION=Muscle Fusion

# --- logos (optional; a file in public/. Leave blank for none) ---
LOGO_JNK=/jnk-logo.svg
LOGO_MUSCLE_FUSION=/muscle-fusion-logo.svg

# which warehouses exist (add a key here + its PIN_/NAME_ pair to add another)
WAREHOUSES=JNK,MUSCLE_FUSION

# --- app ---
SESSION_SECRET=run "node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'"
# Postgres connection string. Shipyard injects this in production, but only for
# a database CREATED with allowDirectDb enabled. It is not a setting you can turn
# on later: the flag is written once, when the database is provisioned, and there
# is no dashboard toggle or API route to change it. Setting this variable by hand
# on the platform does not work either — without that flag the app container is
# never attached to the network the database lives on, so the host does not
# resolve. Turning it on means deleting the database and creating it again.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/inventory_dev
TRUSTED_DEVICE_DAYS=60
NEXT_PUBLIC_TIMEZONE=Asia/Dubai
