# --- logins (PIN is the only key; it also picks the warehouse) ---
PIN_JNK=0000
PIN_MUSCLE_FUSION=0000

# --- labels shown in the app ---
NAME_JNK=JNK Warehouse
NAME_MUSCLE_FUSION=Muscle Fusion

# --- logos (optional; a file in public/. Leave blank for none) ---
LOGO_JNK=/jnk-logo.svg
LOGO_MUSCLE_FUSION=/muscle-fusion-logo.svg

# which warehouses exist (add a key here + its PIN_/NAME_ pair to add another)
WAREHOUSES=JNK,MUSCLE_FUSION

# --- app ---
SESSION_SECRET=run "node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'"
DATABASE_PATH=./data/inventory.db
TRUSTED_DEVICE_DAYS=60
NEXT_PUBLIC_TIMEZONE=Asia/Dubai
